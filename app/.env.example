# Copy this file to app/.env and fill it in. Never commit app/.env.

# PostgreSQL connection string of the hosted database (it must allow the pgvector extension).
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Free Groq API key (console.groq.com/keys): the chat model of the assistant.
# Optional: GROQ_MODEL (default in core/config.py).
GROQ_API_KEY=
